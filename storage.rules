rules_version = '2';

// ═══════════════════════════════════════════════════════════════════
// WAZA KIMURA — Cloud Storage セキュリティルール（案 v1 / 2026-08-13）
//
// ⚠️ このファイルはまだ本番に適用されていません。
//    現在 Firebase コンソールに設定されているルールは未確認です。
//    適用前に、下記「適用手順」を実行してください。
//
// ── 保護対象 ──────────────────────────────────────────────────
//   users/{uid}/videos.json   … 動画ライブラリ本体（js/firebase.js:256, 328）
//   これが他人から読めると、その人の全ライブラリ（動画・タグ・メモ）が
//   まるごと漏れる。Firestore の settings より影響が大きい。
//
// ── 適用手順 ──────────────────────────────────────────────────
//   1. Firebase コンソール → Storage → Rules で現在のルールをバックアップ。
//   2. 適用後、以下を確認する:
//        [ ] 自分の users/{自分のuid}/videos.json  → 読み書きできる
//        [ ] 他人の users/{他人のuid}/videos.json  → 読み書きできない
//        [ ] 未ログイン                            → 読めない
//        [ ] アプリで動画を1本追加 → 保存が通る（トーストが「💾 保存」）
//        [ ] リロードして動画が消えていない
//
// ── 注意 ──────────────────────────────────────────────────────
//   loadUserData は getDownloadURL() を使う。この URL はトークン付きで
//   発行され、URL を知っていれば認証なしで取得できてしまう。
//   ルールで read を絞っても、既に発行済みの URL は失効しない点に注意。
//   （現状は自分のブラウザ内でしか使われないので実害は無いが、
//     URL をログや外部サービスに渡さないこと）
// ═══════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 利用者ごとのファイル。配下すべて本人限定。
    match /users/{uid}/{allPaths=**} {
      allow read: if isSelf(uid);

      // 書き込みは本人のみ。1ファイル 50MB を上限にして、
      // 誤った巨大アップロードでストレージ課金が跳ねるのを防ぐ。
      allow write: if isSelf(uid)
                   && request.resource.size < 50 * 1024 * 1024;
    }

    // それ以外は全部拒否
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
